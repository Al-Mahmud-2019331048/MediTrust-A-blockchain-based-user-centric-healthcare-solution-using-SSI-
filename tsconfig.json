{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "agents/**/*",
    "crypto/**/*",
    "audit/**/*",
    "dwn/**/*",
    "benchmark/**/*",
    "e2e/**/*",
    "backup-provider/**/*"
  ],
  "exclude": ["demo", "interface", "apps/web", "**/node_modules"]
}
